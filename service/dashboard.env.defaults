# Environment defaults for the epsilon-phi mirror of the cyrus_pmg dashboard.
# Sourced by start_dashboard.sh; every value can be overridden in the shell.
# Shape mirrors the host's dashboard.env.defaults.

# Ports
export FRONTEND_PORT="${FRONTEND_PORT:-8001}"
export PMG_SVC_PORT="${PMG_SVC_PORT:-8002}"
export PMG_SVC_WORKERS="${PMG_SVC_WORKERS:-1}"   # the host runs 2; engine caches are per-process

# Auth (stubbed allowlist source - same variable the host uses for local dev).
# The default lets the repo owner straight in; an empty list allows nobody.
export PMG_ALLOWED_KERBEROS="${PMG_ALLOWED_KERBEROS:-fbarker}"

# Which ScenarioPort implementation the service uses:
#   fixtures    static data, no analytics, no database (spec 4.4)
#   live        live analytics; ~97s for a cold portfolio, ~27s warm
#   baked       precomputed results from disk; ~1ms cold. Production default.
export SCENARIO_ADAPTER="${SCENARIO_ADAPTER:-fixtures}"

# Where the bake store lives, and whether an unbaked combination falls through
# to live analytics. With the fallback off the service needs no database at
# all; a miss then surfaces as the column error state with Retry.
export SCENARIO_BAKED_DIR="${SCENARIO_BAKED_DIR:-}"
export SCENARIO_BAKED_FALLBACK="${SCENARIO_BAKED_FALLBACK:-1}"

# Where scenario state is persisted (survives restarts, shared across workers)
export SCENARIO_STORE_DIR="${SCENARIO_STORE_DIR:-}"

# Fixtures adapter failure knobs, for exercising the spec section 10 states:
#   SCENARIO_FIXTURES_LATENCY_MS  delay every resolve_portfolio (e.g. 3000)
#   SCENARIO_FIXTURES_FAIL        "any" or "Allocation|riskLevel" -> resolve raises
#   SCENARIO_FIXTURES_FAIL_SCHEMA=1   get_schema raises (full-page error state)
#   SCENARIO_FIXTURES_FAIL_SLEEVES    "any" or a category name -> list_sleeves raises
#   SCENARIO_FIXTURES_FAIL_EXPORT=1   build_export raises
