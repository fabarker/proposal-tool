# Environment defaults for the epsilon-phi mirror of the cyrus_pmg dashboard.
# Sourced by start_dashboard.sh; every value can be overridden in the shell.
# Shape mirrors the host's dashboard.env.defaults.

# Ports
export FRONTEND_PORT="${FRONTEND_PORT:-8001}"
export PMG_SVC_PORT="${PMG_SVC_PORT:-8002}"
export PMG_SVC_WORKERS="${PMG_SVC_WORKERS:-1}"   # the host runs 2; engine caches are per-process

# Auth (stubbed allowlist source - same variable the host uses for local dev).
# The default lets the repo owner straight in; an empty list allows nobody.
export PMG_ALLOWED_KERBEROS="${PMG_ALLOWED_KERBEROS:-fbarker}"
# Who may maintain the sleeve repository (D57). A subset of the access list;
# empty means nobody, and the console does not appear.
export PMG_ADMIN_KERBEROS="${PMG_ADMIN_KERBEROS:-fbarker}"

# Which ScenarioPort implementation the service uses:
#   fixtures    static data, no analytics, no database (spec 4.4)
#   live        live analytics; ~97s for a cold portfolio, ~27s warm
#   baked       precomputed results from disk; ~1ms cold. Production default.
export SCENARIO_ADAPTER="${SCENARIO_ADAPTER:-baked}"

# Where the bake store lives, and whether an unbaked combination falls through
# to live analytics. With the fallback off the service needs no database at
# all; a miss then surfaces as the column error state with Retry.
export SCENARIO_BAKED_DIR="${SCENARIO_BAKED_DIR:-}"
export SCENARIO_BAKED_FALLBACK="${SCENARIO_BAKED_FALLBACK:-1}"

# The per-asset long-term estimates behind the export's assumptions sheet
# (D67). Unset, the service prefers a bake's own copy beside its slices and
# falls back to the packaged one, so an export always has a fourth sheet.
export SCENARIO_ASSET_ESTIMATES="${SCENARIO_ASSET_ESTIMATES:-}"

# Where scenario state is persisted (survives restarts, shared across workers)
export SCENARIO_STORE_DIR="${SCENARIO_STORE_DIR:-}"

# The strategic universe: the supplying database's extract, one row per holding
# (PortfolioName, AssetTicker, Weight), CSV or XLSX. Every currency, risk level
# and allocation type the UI offers is derived from the names in it (D54).
# Empty means the fictitious stand-in under proposal-tool/saaSource.
export SCENARIO_SAA_SOURCE="${SCENARIO_SAA_SOURCE:-}"

# The delivered rate card (D55): a long CSV, one row per cell -
# schedule, feeGroup, tier, tierMin, tierMax, source, point, rate. Empty means
# the placeholder card packaged beside fees.py. Check a new delivery with
#   python3 -m cyrus_pmg.pmgService.scenario.feeTools --diff <csv>
# before pointing this at it.
export SCENARIO_FEES_SOURCE="${SCENARIO_FEES_SOURCE:-}"

# The product catalogue every sleeve selects from (D56): the product database's
# extract, CSV or XLSX, one row per product. Default: the stand-in under
# proposal-tool/productSource. Read only; it changes by delivery.
export SCENARIO_PRODUCTS_SOURCE="${SCENARIO_PRODUCTS_SOURCE:-}"

# The sleeve repository (D57): a SQLite file the service writes, where an
# admin builds and maintains sleeves from inside the app. Default:
# service/var/sleeves.db. Created and seeded from SCENARIO_SLEEVES_SEED
# (default proposal-tool/sleeveSource/sleeves.csv) the first time it opens;
# after that the database is the library and the seed is never read again.
export SCENARIO_SLEEVES_DB="${SCENARIO_SLEEVES_DB:-}"
export SCENARIO_SLEEVES_SEED="${SCENARIO_SLEEVES_SEED:-}"


# Fixtures adapter failure knobs, for exercising the spec section 10 states:
#   SCENARIO_FIXTURES_LATENCY_MS  delay every resolve_portfolio (e.g. 3000)
#   SCENARIO_FIXTURES_FAIL        "any" or "allocationType|riskLevel" (NA for all-equity) -> resolve raises
#   SCENARIO_FIXTURES_FAIL_SCHEMA=1   get_schema raises (full-page error state)
#   SCENARIO_FIXTURES_FAIL_SLEEVES    "any" or a category name -> list_sleeves raises
#   SCENARIO_FIXTURES_FAIL_EXPORT=1   build_export raises
