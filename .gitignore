# build_styles.py imports pickers / implementation / themes, so running the
# generator leaves bytecode behind. Nothing here ships.
__pycache__/
*.pyc

# Excel lock files
~$*

# Runtime state, written by start_dashboard.sh and the bake. Nothing here is
# source: logs, pidfiles, and the baked analytics, which are derived from the
# database and keyed to a dataversion. Rebuild with
#   python3 -m cyrus_pmg.pmgService.scenario.bake --all
# or, with no database, --adapter fixtures.
service/var/

# The IMF WEO release download writes an empty file relative to the working
# directory before falling back to the vendored copy (D11). Nothing reads it.
service/weo_2026_1.csv
