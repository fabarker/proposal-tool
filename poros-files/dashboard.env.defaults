# ==============================================================================
# Portfolio Optimization Dashboard - environment variable defaults
# ==============================================================================
#
# Sourced by ``start_dashboard.sh`` BEFORE any service is launched, so every
# env var listed here is available to:
#   * this shell script (port resolution, log rotation, etc.)
#   * the FastAPI backends (optimizationService, isgPMGService)
#   * the Flask frontend (dashboardFrontend.py)
#   * every child process forked by the above (uvicorn workers, BackgroundTasks)
#
# Usage:
#   * Do NOT edit this file for local overrides. Instead export the variable
#     in your shell (or in ``dashboard.env.local`` - auto-loaded after this
#     file when present) so upgrades don't clobber your customisations.
#   * Every assignment uses ``: "${VAR:=default}"`` - i.e. the default is
#     only applied when the variable is UNSET or EMPTY, so any value already
#     exported in the parent shell wins.
#   * Every variable is ``export``-ed at the bottom of the file so child
#     processes inherit it.
#
# Convention: group related variables together and keep the defaults in sync
# with the code that reads them (grep for the variable name to find the
# consumer).
# ==============================================================================

# — Service ports & hosts ——————————————————————————————————————————————————————
: "${FRONTEND_PORT:=8001}"           # Flask frontend - user-facing HTML
: "${DASH_HOST:=0.0.0.0}"
: "${OPT_SVC_HOST:=0.0.0.0}"
: "${OPT_SVC_PORT:=8003}"            # FastAPI optimizationService
: "${OPT_SVC_WORKERS:=4}"
: "${PMG_SVC_HOST:=0.0.0.0}"
: "${PMG_SVC_PORT:=8002}"            # FastAPI isgPMGService
: "${PMG_SVC_WORKERS:=2}"

# — Filesystem locations (logs, pid files) ——————————————————————————————————————
: "${LOG_DIR:=/tmp}"
: "${PID_DIR:=/tmp}"
: "${LOG_HISTORY_DIR:=${LOG_DIR}/old}"

# — User / auth ————————————————————————————————————————————————————————————————
# Comma-separated Kerberos principals allowed to hit the dashboard.
# Consumed by cyrus_pmg.pmgService.core.accessControl.
: "${PMG_ALLOWED_KERBEROS:=}"
# Optional override for CUserNameUtil impersonation (used by the ayco
# deployment). Empty → fall back to the OS user.
: "${EXECUTION_USER_NAME:=}"

# — OAuth (AI agent) ———————————————————————————————————————————————————————————
: "${OAUTH_CLIENT_ID:=}"
: "${OAUTH_CLIENT_SECRET:=}"
: "${REQUESTS_CA_BUNDLE:=/etc/ssl/certs/ca-bundle.crt}"
: "${AGENT_PROMPT:=}"

# — ConcertPM integration ——————————————————————————————————————————————————————
# Comma-separated team codes used by DashboardHandler when resolving the
# portfolios-for-optimization directory (account# → portfolioConstructionId).
: "${PMG_CONCERT_TEAM_CODES:=PMGL}"

# — SAA / optimizer wiring —————————————————————————————————————————————————————
# Route optimizations through the SAA service (1) or run the in-process
# optimizer (0). Consumed by optimizationRouter + isgModelCreator +
# dashboardHandler.
: "${USE_SAA_SERVICE:=0}"

# — Axioma file locations ——————————————————————————————————————————————————————
: "${AXIOMA_FILE_DIR:=/home/axiomanonprod/pmgaxioma/filtered/}"
: "${AXIOMA_EFXT_PREFIX:=Composite-ETF-WW.}"
: "${AXIOMA_FAM_PREFIX:=AXWWFAM41-MH.}"

# — PMG service metadata ———————————————————————————————————————————————————————
: "${PMG_SVC_PMG_OPTIMIZATION_VERSION:=0.1}"

# ==============================================================================
# Export everything so child processes (uvicorn workers, Flask, background
# tasks) inherit the resolved values.
# ==============================================================================
export FRONTEND_PORT DASH_HOST
export OPT_SVC_HOST OPT_SVC_PORT OPT_SVC_WORKERS
export PMG_SVC_HOST PMG_SVC_PORT PMG_SVC_WORKERS
export LOG_DIR PID_DIR LOG_HISTORY_DIR
export PMG_ALLOWED_KERBEROS EXECUTION_USER_NAME
export OAUTH_CLIENT_ID OAUTH_CLIENT_SECRET REQUESTS_CA_BUNDLE AGENT_PROMPT
export PMG_CONCERT_TEAM_CODES
export USE_SAA_SERVICE
export AXIOMA_FILE_DIR AXIOMA_EFXT_PREFIX AXIOMA_FAM_PREFIX
export PMG_SVC_PMG_OPTIMIZATION_VERSION
